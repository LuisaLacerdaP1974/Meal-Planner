# Copia este ficheiro para um novo ficheiro chamado ".env" (sem o ".example")
# e substitui pelos teus valores reais.

# Chave de API da Anthropic (para a pesquisa de receitas), criada em https://console.anthropic.com
ANTHROPIC_API_KEY=a-tua-chave-aqui

# Opcional: só é preciso se quiseres sincronizar os dados entre vários aparelhos (telemóvel, tablet, PC)
# usando o "código pessoal". Sem isto, a app funciona na mesma, só guarda os dados nesse aparelho.
# Cria um projeto gratuito em https://supabase.com e copia estes dois valores em Project Settings > API.
SUPABASE_URL=
SUPABASE_KEY=
